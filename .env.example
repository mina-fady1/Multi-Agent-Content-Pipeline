# CLI mode is selected with --mode demo/live; this legacy variable is retained for compatibility.
PIPELINE_MODE=
LLM_PROVIDER=gemini
#https://aistudio.google.com/u/1/api-keys
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
MAX_CONCURRENT_REQUESTS=2
# Optional per-agent overrides (leave blank to use GEMINI_MODEL).
# GEMINI_RESEARCH_MODEL=
# GEMINI_REVIEW_MODEL=
# GEMINI_WRITER_MODEL=
# GEMINI_VISUAL_MODEL=
GEMINI_IMAGE_MODELS=gemini-nano-banana-2.1,gemini-3.1-flash-lite-image,gemini-3.1-flash-image
GEMINI_IMAGE_TIMEOUT=90
# Optional free-tier fallback: use Pillow only when Gemini image quota is unavailable.
# GEMINI_IMAGE_FALLBACK=pillow


# Optional runtime paths
PIPELINE_BRAND_VOICE=brand-voice.md
PIPELINE_KB=kb.json
PIPELINE_RUBRIC=rubric.md
PIPELINE_PRICING=config/model_pricing.json

